{
  "name": "@unblockingapi/mcp",
  "version": "0.4.2",
  "description": "Official MCP server for UnblockingAPI \u2014 web unblocking + SERP for AI agents",
  "type": "module",
  "bin": {
    "unblockingapi-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unblockingapi",
    "scraping",
    "web-unblocking",
    "serp",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://github.com/unblockingapi/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unblockingapi/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/unblockingapi/mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
